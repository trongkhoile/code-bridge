     "Bật 4 Alert BUY / SELL / SL / TP",
     tooltip = "Tạo 4 Alert riêng trên TradingView từ các alertcondition của indicator. Không dùng Any alert() function call.",
     group = "6. Alert TV-MT5 Router"
)

sendSessionEndClose = input.bool(
