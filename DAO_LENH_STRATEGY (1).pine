     tooltip = "Nhãn SL/TP/Hết giờ được tự đẩy ra ngoài High/Low của nến. Giá trị lớn hơn sẽ đặt nhãn xa nến hơn.",
     group = "5. Tính tiền lãi/lỗ"
)

