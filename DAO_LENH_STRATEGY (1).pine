     tooltip = "Hiển thị một nhãn động bên phải cây nến hiện tại. Nhãn đi theo giá Close thời gian thực và tự đổi xanh/đỏ theo lãi/lỗ.",
     group = "5. Tính tiền lãi/lỗ"
)

runningPnlLabelBarOffset = input.int(
     1,
     "Nhãn lãi/lỗ cách nến (bar)",
     minval = 1,
     maxval = 5,
     tooltip = "Khoảng cách theo chiều ngang giữa nhãn lãi/lỗ đang chạy và cây nến hiện tại.",
     group = "5. Tính tiền lãi/lỗ"
)
//==================================================
// 6. ALERT RIÊNG BUY / SELL / SL / TP CHO TV-MT5 ROUTER
//==================================================
enableRouterAlerts = input.bool(
