)

//==================================================
// 7. BẢNG THỐNG KÊ GỘP
//==================================================
// Tắt toàn bộ bảng biểu trên biểu đồ.
bool showStatsTable = false

bool showDailyTable = false

bool showMonthlyTable = false

string statsTitle = "CÁ MẬP VÀNG"

